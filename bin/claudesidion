#!/usr/bin/env python3
"""claudesidion — one command for every tool the skills and hooks run.

    claudesidion vault-path                      print the resolved vault path
    claudesidion code-root                       print the resolved code root
    claudesidion lint [--count] [--vault P]      report notes that break the format contract
    claudesidion maintain [--vault P]            refresh derived frontmatter and indexes
    claudesidion claim [--vault P]               record this plugin's version in the vault
    claudesidion rename [--vault P] [--dry-run] OLD NEW
                                                 rename a note and rewrite every link to it
    claudesidion qualify [--vault P] [--dry-run] qualify ambiguous wikilinks
    claudesidion hours [session_hours options]   measure time spent from session transcripts
    claudesidion start [--format F]              session start: commit leftovers, pull, checks
    claudesidion end                             session end: maintain indexes, commit, push

`start` and `end` are the session hooks, for harnesses that do not run Claude Code's
hooks/hooks.json. `start` prints the session context once, in the harness's format:
`--format claude` (hookSpecificOutput JSON, the default), `cursor` ({"additional_context": ...})
or `plain` (text). `end` prints anything worth reporting as plain text; the next `start` relays
it too, since few harnesses show session-end output.

The vault resolves as the hooks do: --vault, $OBSIDIAN_VAULT, ~/.config/claudesidion/vault,
~/.claude/obsidian-vault, then ~/ObsidianVault.

A skill installed on its own has no plugin folder to find scripts in, so it calls this command
instead; put it on PATH with `ln -s <plugin root>/bin/claudesidion ~/.local/bin/`. It locates the
rest of the plugin through that symlink.
"""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path[:0] = [str(ROOT / "hooks"), str(ROOT / "scripts")]

import claudesidion_paths as paths  # noqa: E402


def take_vault(args: list[str]) -> tuple[str, list[str]]:
    """Pull `--vault P` / `--vault=P` out of args; return the resolved vault and the rest."""
    explicit, rest, it = None, [], iter(args)
    for a in it:
        if a == "--vault":
            explicit = next(it, None)
        elif a.startswith("--vault="):
            explicit = a.split("=", 1)[1]
        else:
            rest.append(a)
    return str(paths.resolve_vault(explicit)), rest


def run_maintainer(args: list[str], *flags: str) -> int:
    import vault_maintain

    vault, rest = take_vault(args)
    return vault_maintain.main([*flags, *rest, vault])


START_HOOKS = ("vault-pull.sh", "vault-size-check.sh", "vault-condense-reminder.sh")
END_HOOKS = ("vault-maintain.sh", "vault-push.sh")
FORMATS = ("claude", "cursor", "plain")


def run_hooks(names: tuple[str, ...], fmt: str = "plain") -> list[str]:
    """Run hook scripts in order and return what each printed, skipping silent ones."""
    import os
    import subprocess

    env = {**os.environ, "CLAUDESIDION_FORMAT": fmt, "CLAUDE_PLUGIN_ROOT": str(ROOT)}
    out = []
    for name in names:
        try:
            r = subprocess.run(["bash", str(ROOT / "hooks" / name)], env=env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired):
            continue                       # fail open, like the hooks themselves
        if r.stdout.strip():
            out.append(r.stdout.strip())
    return out


def session_start(args: list[str]) -> int:
    import json

    fmt = "claude"
    for i, a in enumerate(args):
        if a.startswith("--format="):
            fmt = a.split("=", 1)[1]
        elif a == "--format" and i + 1 < len(args):
            fmt = args[i + 1]
    if fmt not in FORMATS:
        print(f"claudesidion: unknown format '{fmt}' (one of {', '.join(FORMATS)})", file=sys.stderr)
        return 2
    ctx = "\n\n".join(run_hooks(START_HOOKS))
    if not ctx:
        return 0
    if fmt == "plain":
        print(ctx)
    elif fmt == "cursor":
        print(json.dumps({"additional_context": ctx}))
    else:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                                 "additionalContext": ctx}}))
    return 0


def session_end(args: list[str]) -> int:
    for text in run_hooks(END_HOOKS):
        print(text)
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]

    if cmd == "vault-path":
        print(paths.resolve_vault())
        return 0
    if cmd == "code-root":
        print(paths.resolve_code_root())
        return 0
    if cmd == "lint":
        return run_maintainer(args, "--lint")
    if cmd == "maintain":
        return run_maintainer(args)
    if cmd == "claim":
        return run_maintainer(args, "--claim")
    if cmd == "rename":
        import rename_note
        return rename_note.main(args)
    if cmd == "qualify":
        import qualify_links
        return qualify_links.main(args)
    if cmd == "start":
        return session_start(args)
    if cmd == "end":
        return session_end(args)
    if cmd == "hours":
        import session_hours
        return session_hours.main(args)

    print(f"claudesidion: unknown command '{cmd}' (see claudesidion --help)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
